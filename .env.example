# ---------------------------------------------------------------------------
# GRIDS configuration (copy to .env and adjust as needed)
# ---------------------------------------------------------------------------

# Backend ---------------------------------------------------------------
GRIDS_DATABASE_URL=sqlite:///./backend/data/grids.db
GRIDS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GRIDS_DEFAULT_RATE_HZ=10
GRIDS_MAX_DURATION_S=1800
GRIDS_ECHO_SQL=0

# Anomaly detection tuning ----------------------------------------------
GRIDS_ANOMALY_NIS_GATE=16.27
GRIDS_ANOMALY_JUMP_M=25.0

# Optional ML drift-correction layer (disabled by default) --------------
GRIDS_ML_CORRECTION_DEFAULT=0
GRIDS_ML_MODEL_PATH=./backend/ml_artifacts/ml_correction.joblib
GRIDS_ML_DATASET_PATH=./backend/ml_artifacts/eval_report.json

# Optional OpenStreetMap road data (navigation never depends on it) -----
GRIDS_ENABLE_OSM=0
GRIDS_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Frontend --------------------------------------------------------------
# Leave empty to use relative /api URLs through the Vite proxy (recommended).
VITE_API_BASE=
# Optional explicit WebSocket URL; by default the browser uses
# ws(s)://<current host>/api/ws/simulation through the proxy.
VITE_WS_URL=
# Used only by the Vite dev proxy (server side, not the browser)
VITE_BACKEND_PROXY=http://127.0.0.1:8000
