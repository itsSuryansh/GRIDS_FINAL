# ---------------------------------------------------------------------------
# GRIDS configuration (copy to .env and adjust as needed)
# ---------------------------------------------------------------------------

# Backend ---------------------------------------------------------------
GRIDS_DATABASE_URL=sqlite:///./backend/data/grids.db
GRIDS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GRIDS_DEFAULT_RATE_HZ=10
GRIDS_MAX_DURATION_S=1800
GRIDS_ECHO_SQL=0

# Anomaly detection tuning ----------------------------------------------
GRIDS_ANOMALY_NIS_GATE=16.27
GRIDS_ANOMALY_JUMP_M=25.0

# Optional ML drift-correction layer (disabled by default) --------------
GRIDS_ML_CORRECTION_DEFAULT=0
GRIDS_ML_MODEL_PATH=./backend/ml_artifacts/ml_correction.joblib
GRIDS_ML_DATASET_PATH=./backend/ml_artifacts/eval_report.json

# OpenStreetMap road geometry + cached basemap tiles (optional) ---------
# 1 = try to fetch real road data and map tiles (cached on disk afterwards);
# 0 = fully offline: synthetic street lattice + offline graticule basemap.
# Navigation never depends on this: a failure only changes the map backdrop.
GRIDS_MAP_ONLINE=1
GRIDS_MAP_TIMEOUT=2.5
GRIDS_MAP_BACKOFF=600
# Primary source: plain OSM map-data endpoint (fast, no query language)
GRIDS_OSM_API=https://api.openstreetmap.org/api/0.6/map
GRIDS_OSM_TIMEOUT=12
# Secondary source: Overpass mirrors, tried in order
GRIDS_OVERPASS_MIRRORS=https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter
# Basemap tile templates, tried in order (watermark placeholders rejected)
GRIDS_TILE_URLS=https://tile.openstreetmap.org/{z}/{x}/{y}.png,https://a.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png

# Legacy alias kept for backwards compatibility (maps onto GRIDS_MAP_ONLINE)
GRIDS_ENABLE_OSM=1

# Frontend --------------------------------------------------------------
# Leave empty to use relative /api URLs through the Vite proxy (recommended).
VITE_API_BASE=
# Optional explicit WebSocket URL; by default the browser uses
# ws(s)://<current host>/api/ws/simulation through the proxy.
VITE_WS_URL=
# Used only by the Vite dev proxy (server side, not the browser)
VITE_BACKEND_PROXY=http://127.0.0.1:8000
